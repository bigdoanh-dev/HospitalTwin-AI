{
  "name": "hospital-twin-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && PYTHONPATH=. ./.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "test:backend": "cd backend && PYTHONPATH=. ./.venv/bin/pytest tests/",
    "setup": "./scripts/setup.sh"
  }
}
